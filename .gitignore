# ==========================================
# VoxWhisper Project Specific Exclusions
# ==========================================
# Exclude raw clinical scans and processed NumPy patches
data/raw/
data/raw_masks/
data/processed_*/
data/predictions/
output/
trained_models/

# Exclude pre-computed text embeddings and trained model checkpoints
cache/*/*.pt
cache/*.npy
cache/*.npz
runs/

# ==========================================
# Python Environment & Caches
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (General & local specific envs)
venv/
.venv/
env/
ENV/
ImperialEnv/

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*~
.virtual_documents/

# ==========================================
# OS Specific Files
# ==========================================
# macOS specific system files (crucial for Mac developers)
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# ==========================================
# IDE / Editor Settings
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/

# General editor backups
*~
*.swp
*.swo